# Copy to .env.local for local development, and set the same values in Vercel.

# Required for the contact, quote and newsletter forms.
RESEND_API_KEY=

# Required for /admin. Login is disabled until both are set.
ADMIN_CREDENTIALS_USERNAME=
ADMIN_CREDENTIALS_PASSWORD=

# Optional. Signs admin sessions. Falls back to a value derived from the credentials.
ADMIN_SESSION_SECRET=

# Optional. Where enquiries are delivered.
CONTACT_NOTIFICATION_EMAIL=

# Google Analytics measurement ID. The tag is only added when this is set.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional. Sender for form emails, on a domain verified in Resend. Defaults to Resend's test sender.
EMAIL_FROM=

# Optional. Base URL for canonical links and the sitemap. Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=
